# ============================================================================
# Mr. Trámite — Variables de entorno
# ============================================================================
# Copia este archivo a .env y llena los valores.
# En Vercel, configura estas variables en Project Settings → Environment Variables.
# ============================================================================

# --- Base de datos (Neon PostgreSQL en producción) ---
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# --- NextAuth ---
NEXTAUTH_URL="https://mrtramite.mx"
NEXTAUTH_SECRET="genera-con-openssl-rand-base64-32"

# --- Cloudinary (subida de documentos) ---
CLOUDINARY_CLOUD_NAME="nvjxzuy1"
CLOUDINARY_API_KEY="625352864946639"
CLOUDINARY_API_SECRET="tu-secret-aqui"

# --- Telegram (notificaciones internas al equipo) ---
TELEGRAM_BOT_TOKEN="8881494191:AAHiwhfJN3PoPAygiK8ZsM3q-DJoSPp5PN0"
TELEGRAM_CHAT_ID="1572031936"

# --- Mercado Pago (pagos reales) ---
# Obtén estas credenciales en https://www.mercadopago.com.mx/developers/panel/app
# Usar credenciales de PRODUCCIÓN para procesar pagos reales.
MERCADO_PAGO_ACCESS_TOKEN="APP_USR-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# Opcional pero recomendado: valida la firma del webhook para evitar fraudes
# Genera un secreto aleatorio (ej: openssl-rand-base64 32) y configúralo igual
# en el panel de MP → Webhooks → "Clave secreta de firma"
MERCADO_PAGO_WEBHOOK_SECRET=""

# --- Resend (emails transaccionales) ---
RESEND_API_KEY="re_xxxxxxxxxxxx"
EMAIL_FROM="Mr. Trámite <noreply@mrtramite.mx>"

# --- LOGAN OS Chat Widget (frontend, sin backend) ---
# No requiere variables — el widget llama directamente a LOGAN OS desde el navegador
