# Base de datos (usar Postgres en producción con Neon)
DATABASE_URL="postgresql://usuario:password@host/database?sslmode=require"

# NextAuth (CAMBIAR en producción con: openssl rand -base64 32)
NEXTAUTH_SECRET="cambiar-por-un-secret-seguro"
NEXTAUTH_URL="https://tu-dominio.com"

# Cloudinary
CLOUDINARY_CLOUD_NAME="tu_cloud_name"
CLOUDINARY_API_KEY="tu_api_key"
CLOUDINARY_API_SECRET="tu_api_secret"

# Telegram
TELEGRAM_BOT_TOKEN="tu_bot_token"
TELEGRAM_CHAT_ID="tu_chat_id"

# Botpress webhook (clave compartida)
BOTPRESS_WEBHOOK_KEY="generar-clave-aleatoria-segura"

# Resend (emails - opcional)
# RESEND_API_KEY="re_tu_api_key"
# RESEND_FROM_EMAIL="contacto@tudominio.com"
